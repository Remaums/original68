# ══════════════════════════════════════════════════════════════
# Original68 — réglages
#
# Ce fichier est un MODÈLE, suivi par git. Le vrai fichier s'appelle
# « .env », il est ignoré par git et c'est à toi de le créer :
#
#     cp .env.example .env
#
# Les valeurs ci-dessous sont déjà celles de Original68. Deux lignes seulement
# sont à remplir pour démarrer : BOT_TOKEN et les deux identifiants admin.
# ══════════════════════════════════════════════════════════════

# À REMPLIR — le jeton du bot, donné par @BotFather.
# Obligatoire même pour un simple aperçu : la boutique s'en sert pour
# vérifier la signature de Telegram, et refuse de démarrer sans lui.
BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ

# URL publique HTTPS de la Mini App (obligatoire pour Telegram).
# En local : utilise un tunnel (ngrok, cloudflared) et colle l'URL https ici.
WEBAPP_URL=https://ton-domaine.exemple.com

# À REMPLIR — ton identifiant Telegram (un nombre, pas un pseudo).
# Pour le connaître : envoie /start au bot, il te l'affiche.
ADMIN_CHAT_ID=123456789

# Nom du bot sans @ (facultatif : demandé à Telegram sinon).
# Sert à fabriquer les liens qui ouvrent la boutique sur un produit précis.
BOT_USERNAME=

# ── Le bot de secours ─────────────────────────────────────────
# Un second bot, créé chez @BotFather comme le premier, qui sert la même
# boutique. Il tourne EN MÊME TEMPS que le principal, il n'attend pas la
# panne : Telegram interdit à un bot d'écrire le premier à quelqu'un qui ne
# l'a jamais démarré, donc un secours que personne n'a enregistré avant la
# panne ne peut joindre personne.
#
# Laisse ces deux lignes vides et tout ce qui touche au secours s'éteint :
# pas de second bot, pas de carte dans la boutique, pas de veille.
BOT_TOKEN_SECOURS=
BOT_USERNAME_SECOURS=

# Port du serveur HTTP. 3300 : c'est ce qui permet de faire tourner les quatre
# boutiques (Napoli 3000, Tanja 3100, La Grosse Frappe 3200, Original68 3300)
# en même temps sur la même machine.
PORT=3300

# Devise affichée dans la boutique
CURRENCY=EUR

# Nom de la boutique
SHOP_NAME=Original68

# Ton compte Telegram perso, SANS le @ (facultatif).
#
# Le bouton « Commander » n'ouvre plus de conversation : il explique au
# client de passer commande sur Snapchat. Ce compte ne sert qu'aux messages
# relayés et aux alertes ; vide, il se règle aussi depuis le panneau admin.
SELLER_USERNAME=

# Préfixe des références de commande (O68-A1B2C3).
ORDER_PREFIX=O68

# À REMPLIR — identifiants Telegram autorisés à ouvrir l'espace admin
# (séparés par des virgules).
# Les deux listes sont réunies : ADMIN_CHAT_ID est admin lui aussi, qu'ADMIN_IDS
# soit rempli ou non. Envoie /start au bot pour connaître ton ID.
ADMIN_IDS=123456789

# ── Copie locale des photos et vidéos ────────────────────────
#
# Les médias restent hébergés chez Telegram : la boutique n'en garde que la
# référence. Sans copie locale, chaque première vue fait l'aller-retour
# VPS → Telegram → VPS → client, et une vidéo se fait attendre. La boutique en
# garde donc une copie dans server/data/media-cache/ : seul le premier
# visiteur paie le trajet.
#
# Plafond en mégaoctets. Le dossier se vide tout seul, du plus anciennement
# servi au plus récent. 0 éteint la copie (la boutique relaie alors à chaque
# fois). Inutile de toucher à ça en serverless : le disque y est en lecture
# seule, la copie s'éteint d'elle-même et le dit au démarrage.
# MEDIA_CACHE_MB=500

# Pour ranger les copies ailleurs (un disque plus grand, par exemple).
# MEDIA_CACHE_DIR=/var/cache/original68

# ── Mise en ligne serverless (Vercel + Postgres) ─────────────
#
# CES DEUX LIGNES RESTENT COMMENTÉES SUR UN VPS, et c'est le cas courant.
# Renseigner DATABASE_URL fait basculer toute la boutique sur Postgres : si
# l'adresse n'est pas joignable, plus rien ne s'affiche. Sans elle, les
# données vivent dans server/data/ et le bot lit en long polling — ce qu'il
# faut sur un serveur qui tourne en permanence.
#
# Ne les décommente que pour un déploiement serverless, où le disque est en
# lecture seule et où chaque requête peut atterrir sur une autre instance.

# Postgres (Neon, Supabase, Vercel Postgres…). Utilise la chaîne « pooled »
# du fournisseur : en serverless, chaque requête ouvre sa propre connexion.
# DATABASE_URL=postgres://utilisateur:motdepasse@adresse/base?sslmode=require

# Jeton partagé avec Telegram pour signer les appels du webhook.
# Génère-le au hasard : openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=
